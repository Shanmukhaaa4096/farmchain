# =============================================================================
# FarmChain Environment Variables Configuration
# =============================================================================
# IMPORTANT:
# - NEVER commit real secrets or production service_role keys to source control.
# - In Vercel / Production, configure these environment variables in project settings.
# =============================================================================

# --- Supabase Project Credentials ---
# Public URL and anon public key from Supabase Project Settings -> API.
# Safe for client-side bundle exposure with Supabase Row-Level Security (RLS).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key

# --- OTP & Authentication Mode ---
# Options:
#   - "demo": Uses DemoOtpProvider with fixed OTP (123456) for whitelisted phone numbers.
#             Blocks admin logins via demo mode. Shows "Demo mode" banner in UI.
#   - "supabase": Uses SupabaseOtpProvider with supabase.auth.signInWithOtp() for real SMS.
#   - "off": Disables OTP login and prompts users to use Email or Google OAuth.
# Default: "demo"
VITE_OTP_MODE=demo

# --- Demo Mode Allowed Phone Numbers ---
# Comma-separated list of 10-digit Indian mobile numbers authorized for demo login.
# Any phone number NOT in this list will receive:
# "SMS login is not switched on in this demo. Please use email or Google."
VITE_DEMO_PHONES=9849201842,9876543210

# --- Pre-Created Demo Non-Admin Accounts ---
# Credentials for pre-created testing accounts in Supabase:
# 1. Demo Farmer account
VITE_DEMO_FARMER_EMAIL=farmer.demo@farmchain.org
VITE_DEMO_FARMER_PASSWORD=FarmChainDemo2026!
VITE_DEMO_FARMER_PHONE=9849201842

# 2. Demo Buyer account
VITE_DEMO_BUYER_EMAIL=buyer.demo@farmchain.org
VITE_DEMO_BUYER_PASSWORD=FarmChainDemo2026!
VITE_DEMO_BUYER_PHONE=9876543210

# --- Data & Pilot Configuration ---
# Regional pilot identifier and currency defaults
VITE_PILOT_REGION=Telangana-Rural-Corridor
VITE_DEFAULT_CURRENCY=INR
